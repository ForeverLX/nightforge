# --- OBSERVER (AgentsView) ---
alias av='agentsview'
alias av-serve='agentsview serve --background'
alias av-usage='agentsview usage daily --breakdown'
alias av-stop='agentsview serve stop'
unalias agent-budget 2>/dev/null
function agent-budget {
    echo "=== 7-Day Agent Burn ==="
    local since
    since=$(date -d "7 days ago" +%Y-%m-%d 2>/dev/null || date -v-7d +%Y-%m-%d 2>/dev/null)
    agentsview usage daily --breakdown --since "$since" | tail -10
}

