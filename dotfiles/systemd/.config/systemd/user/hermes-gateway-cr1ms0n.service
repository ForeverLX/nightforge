[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/ForeverLX/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main --profile cr1ms0n gateway run
WorkingDirectory=/home/ForeverLX/.hermes/profiles/cr1ms0n
Environment="PATH=/home/ForeverLX/.hermes/hermes-agent/venv/bin:/home/ForeverLX/.hermes/hermes-agent/node_modules/.bin:/usr/sbin:/home/ForeverLX/.local/bin:/home/ForeverLX/.cargo/bin:/home/ForeverLX/go/bin:/home/ForeverLX/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/ForeverLX/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/ForeverLX/.hermes/profiles/cr1ms0n"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/ForeverLX/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
