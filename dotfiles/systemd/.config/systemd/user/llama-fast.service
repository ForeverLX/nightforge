[Unit]
Description=llama-server fast lane (Qwen3.5-9B Q4_K_M) - aux/Fast roles (Pi cheap tier)
After=network.target
# Mutual exclusion with the primary quality lane (llama-local.service / 27B):
# Both need full 8GB GPU. Loading order: start fast -> stop primary; stop fast -> restart primary.
Wants=llama-local.service

[Service]
Type=simple
# Stop the primary quality lane before loading the fast lane (frees the GPU)
ExecStartPre=/usr/bin/systemctl --user stop llama-local.service
ExecStart=/home/ForeverLX/.local/bin/llama-server -m /home/ForeverLX/models/Qwen3.5-9B-Q4_K_M.gguf --port 18235 -ngl 99 -c 32768 --host 127.0.0.1 --cache-type-k q8_0 --cache-type-v q8_0 --threads 4 --threads-batch 4 --flash-attn auto --jinja --batch-size 2048 --ubatch-size 512
# Restart the primary quality lane when the fast lane stops (returns to primary)
ExecStopPost=/usr/bin/systemctl --user start llama-local.service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
