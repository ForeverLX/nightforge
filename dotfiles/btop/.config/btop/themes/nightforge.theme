# Btop Matugen Theme
# Generated by matugen — place in ~/.config/btop/themes/

# Main colors
theme[main_bg]="#140c0c"
theme[main_fg]="#f0dede"
theme[title]="#ffb3b3"
theme[hi_fg]="#ffb3b3"
theme[selected_bg]="#733336"
theme[selected_fg]="#f0dede"
theme[inactive_fg]="#a08c8c"
theme[graph_text]="#d7c1c1"
theme[proc_misc]="#a08c8c"

# Box borders
theme[cpu_box]="#ffb3b3"
theme[mem_box]="#e6bdbc"
theme[net_box]="#e5c18d"
theme[proc_box]="#ffb3b3"
theme[div_line]="#a08c8c"

# Meter
theme[meter_bg]="#271d1d"
theme[meter_fg]="#ffb3b3"

# Status
theme[error]="#ffb4ab"
theme[warning]="#e5c18d"
theme[good]="#e6bdbc"

# Gradients
theme[temp_start]="#e5c18d"
theme[temp_mid]="#e6bdbc"
theme[temp_end]="#ffb4ab"

theme[cpu_start]="#ffb3b3"
theme[cpu_mid]="#e6bdbc"
theme[cpu_end]="#e5c18d"

theme[mem_start]="#e6bdbc"
theme[mem_mid]="#ffb3b3"
theme[mem_end]="#e5c18d"

theme[free_start]="#ffb3b3"
theme[free_mid]="#e6bdbc"
theme[free_end]="#e5c18d"

theme[cached_start]="#ffb3b3"
theme[cached_mid]="#e6bdbc"
theme[cached_end]="#e5c18d"

theme[available_start]="#ffb3b3"
theme[available_mid]="#e6bdbc"
theme[available_end]="#e5c18d"

theme[used_start]="#ffb3b3"
theme[used_mid]="#e6bdbc"
theme[used_end]="#e5c18d"

theme[download_start]="#e5c18d"
theme[download_mid]="#ffb3b3"
theme[download_end]="#e6bdbc"

theme[upload_start]="#e5c18d"
theme[upload_mid]="#ffb3b3"
theme[upload_end]="#e6bdbc"

theme[process_start]="#ffb3b3"
theme[process_mid]="#e6bdbc"
theme[process_end]="#e5c18d"
