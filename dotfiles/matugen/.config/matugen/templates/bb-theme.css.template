/* bb custom theme — generated by matugen (wallpaper-derived palette).
   Installed at <data-dir>/theme/<name>/theme.css, activated via `bb theme set <name>`.
   Overrides the anchor tokens in apps/app/src/components/ui/theme.css:
   - --canvas/--ink anchors drive every neutral surface (card, sidebar, borders)
   - --primary drives accent + ring + selection
   - semantic tokens: destructive=error, warning/attention=warm roles,
     timeline/file accent=cool secondary role
   Tiers: muted > readback > subtle (dark) / muted < readback < subtle (light). */
:root, .light {
  color-scheme: light;
  --canvas: {{colors.background.light.hex}};
  --ink: {{colors.on_background.light.hex}};
  --primary: {{colors.primary.light.hex}};
  --primary-foreground: {{colors.on_primary.light.hex}};
  --timeline-accent: {{colors.secondary.light.hex}};
  --file-accent: var(--timeline-accent);
  --muted-foreground: {{colors.on_surface_variant.light.hex}};
  --readback-foreground: {{colors.on_surface_variant.light.hex | to_color | lighten: 8.0 | format: "hex"}};
  --subtle-foreground: {{colors.on_surface_variant.light.hex | to_color | lighten: 16.0 | format: "hex"}};
  --destructive: {{colors.error.light.hex}};
  --destructive-foreground: {{colors.on_error.light.hex}};
  --destructive-text: {{colors.error.light.hex}};
  --warning: {{colors.tertiary.light.hex}};
  --warning-text: {{colors.tertiary.light.hex}};
  --attention: {{colors.primary_container.light.hex}};
  --pr-merged: {{colors.primary.light.hex}};
  --diff-removed: {{colors.error.light.hex}};
}
.dark {
  color-scheme: dark;
  --canvas: {{colors.background.dark.hex}};
  --ink: {{colors.on_background.dark.hex}};
  --primary: {{colors.primary.dark.hex}};
  --primary-foreground: {{colors.on_primary.dark.hex}};
  --timeline-accent: {{colors.secondary.dark.hex}};
  --file-accent: var(--timeline-accent);
  --muted-foreground: {{colors.on_surface_variant.dark.hex}};
  --readback-foreground: {{colors.on_surface_variant.dark.hex | to_color | lighten: -8.0 | format: "hex"}};
  --subtle-foreground: {{colors.on_surface_variant.dark.hex | to_color | lighten: -16.0 | format: "hex"}};
  --destructive: {{colors.error.dark.hex}};
  --destructive-foreground: {{colors.on_error.dark.hex}};
  --destructive-text: {{colors.error.dark.hex}};
  --warning: {{colors.tertiary.dark.hex}};
  --warning-text: {{colors.tertiary.dark.hex}};
  --attention: {{colors.primary_fixed.dark.hex}};
  --pr-merged: {{colors.primary.dark.hex}};
  --diff-removed: {{colors.error.dark.hex}};
}
