#!/bin/bash
# Block AI agent co-author trailers from GitHub contributor attribution
# Blocklist is maintained in .git/hooks/blocklist

BLOCKLIST="$(dirname "$0")/blocklist"
COMMIT_MSG="$1"

# Default blocklist if file doesn't exist
if [ ! -f "$BLOCKLIST" ]; then
    sed -i '/^Co-authored-by:.*\(Bot\|bot\|AI\|Claude\|Copilot\|Cursor\|Aider\|ChatGPT\|OpenAI\|Anthropic\|CommandCode\)/d' "$COMMIT_MSG"
    exit 0
fi

# Read blocklist and strip matching trailers
while IFS= read -r pattern || [ -n "$pattern" ]; do
    # Skip empty lines and comments
    [[ -z "$pattern" || "$pattern" =~ ^# ]] && continue
    sed -i "/^Co-authored-by:.*${pattern}/d" "$COMMIT_MSG"
done < "$BLOCKLIST"
