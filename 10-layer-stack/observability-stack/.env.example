# Copy to .env and replace every REPLACE_* value before operator startup.
# Never commit .env or real keys.
# Passwords below are interpolated raw into DATABASE_URL and the ClickHouse
# migration DSN. Use hex/alphanumeric only - special chars break URL parsing.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
CLICKHOUSE_PASSWORD=REPLACE_WITH_RANDOM_CLICKHOUSE_PASSWORD
# Single-node ClickHouse has no Zookeeper/Keeper, so clustered migrations
# (ON CLUSTER + ReplicatedMergeTree) fail with error code 139. Keep false.
CLICKHOUSE_CLUSTER_ENABLED=false
REDIS_AUTH=REPLACE_WITH_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_RANDOM_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_PASSWORD
SALT=REPLACE_WITH_RANDOM_SALT
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_NEXTAUTH_SECRET
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
# Base64 of Langfuse public-key:secret-key, e.g. printf '%s' 'pk-lf-...:sk-lf-...' | base64 -w 0
LANGFUSE_AUTH_STRING=REPLACE_WITH_BASE64_PUBLIC_KEY_COLON_SECRET
